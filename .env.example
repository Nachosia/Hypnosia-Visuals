# Copy this file to .env on the server or your local machine.
# Never commit .env, private keys, database files, or real API tokens.

HYPNOSIA_LICENSE_HOST=127.0.0.1
HYPNOSIA_LICENSE_PORT=8080
HYPNOSIA_DATABASE_URL=jdbc:sqlite:./data/hypnosia-licenses.db

# Generate a long random value on the server.
HYPNOSIA_ADMIN_TOKEN=change-me-do-not-commit

# Public mod clients can know only the API base URL.
# Do not put VPS password, SSH private keys, or database passwords in the mod repository.
HYPNOSIA_PUBLIC_API_URL=https://licenses.example.com
